# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# Data Engineering Pipeline Configuration
# ==========================================
# Database Connection (MySQL 8.0 Only)
DB_DRIVER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=pipeline_curated
MYSQL_DATABASE_TEST=pipeline_curated_test
MYSQL_CONNECTION_LIMIT=10

# Storage Directories (Relative to project root or absolute paths)
STORAGE_INCOMING_DIR=./data/incoming
STORAGE_RAW_DIR=./data/raw
STORAGE_VALIDATED_DIR=./data/validated
STORAGE_REJECTED_DIR=./data/rejected
STORAGE_CURATED_DIR=./data/curated
STORAGE_REPORTS_DIR=./reports
STORAGE_LOGS_DIR=./logs

# Pipeline Execution Settings
PIPELINE_CHUNK_SIZE=1000
PIPELINE_BATCH_SIZE=2500
LOG_LEVEL=info
NODE_ENV=development
